#!/usr/bin/env node
// gh-dash: the local dashboard for gh-coord (GH-129). Each chat is a card in its stage
// (work -> review <-> fix -> merge -> the integration branch); arrows light when the coordinator log
// shows a ticket moving between stages. Also the DB lock, heavy slots, the local stack, a lock
// timeline, the machine's gauges and the log. The start buttons open named Claude Code chats.
//
// It is also the one process on this machine that talks to Greenhouse: it reports its chats and a
// machine summary to report_agent_state, and takes start requests queued for this machine from a
// ticket page. Run it from inside the repo (or any worktree of it).
//
//   gh-dash                    serves http://127.0.0.1:${GREENHOUSE_DASH_PORT:-7777} (the next free port when taken)
//   gh-dash --open             same, and opens it in the browser
//   gh-dash --detach [--open]  starts it in the background, so it outlives the chat or terminal that started it
//   gh-dash --report-preview   prints exactly what it would send Greenhouse, and exits
//
// Reads gh-coord's config (the repo's greenhouse block plus GREENHOUSE_* env vars). Also honors
// GREENHOUSE_DASH_PORT, GREENHOUSE_TERMINAL (terminal | iterm) and GREENHOUSE_PLUGIN_DIR (a plugin
// checkout that terminal and background starts load with --plugin-dir, for trying the plugin
// before a release).
'use strict';
const http = require('node:http');
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');
const { execFile, execFileSync, spawn } = require('node:child_process');
const { randomUUID } = require('node:crypto');

// gh-dash isn't a chat, and it's usually started from one (`! gh-dash --detach`, or a loop skill).
// Drop that chat's Claude Code session variables (CLAUDECODE, CLAUDE_CODE_SESSION_ID,
// CLAUDE_CODE_CHILD_SESSION, its messaging socket and token, ...): otherwise every chat started here
// inherits them and runs as that chat's child, with no transcript or session file of its own, and a
// Terminal launched from here would pass them to every window. CLAUDE_CONFIG_DIR stays.
for (const name of Object.keys(process.env)) {
  if (name === 'CLAUDECODE' || name.startsWith('CLAUDE_CODE_')) delete process.env[name];
}

const BIN = __dirname;
const ARGS = process.argv.slice(2);

function loadConfig() {
  const out = execFileSync(path.join(BIN, 'gh-coord'), ['config'], { encoding: 'utf8', timeout: 15000, stdio: ['ignore', 'pipe', 'pipe'] });
  const cfg = {};
  for (const line of out.split('\n')) {
    const i = line.indexOf('=');
    if (i > 0) cfg[line.slice(0, i)] = line.slice(i + 1);
  }
  return cfg;
}
let CFG;
try { CFG = loadConfig(); } catch (e) {
  console.error(`gh-dash: ${String(e.stderr || e.message).trim()}`);
  process.exit(1);
}

const KEY = CFG.KEY;
const key = KEY.toLowerCase();
const MAIN = CFG.MAIN;
const STATE = CFG.STATE;
const BASE = CFG.BASE;
const PROJECT_ID = CFG.PROJECT_ID;
const MACHINE = CFG.MACHINE;
const LOCAL_STACK = CFG.LOCAL_STACK || '';
const STALE_MIN = Number(CFG.STALE_MIN || 30);
const HEAVY_SLOTS = Number(CFG.HEAVY_SLOTS || 1);
const BASE_PORT = Number(process.env.GREENHOUSE_DASH_PORT || 7777);
const TERMINAL = process.env.GREENHOUSE_TERMINAL === 'iterm' ? 'iterm' : 'terminal';
const PLUGIN_DIR = process.env.GREENHOUSE_PLUGIN_DIR || '';
const TIMELINE_H = 6;
const IDLE_CHAT_MIN = 30; // chats with no claim and no open session drop off after this long unseen
const QUIET_MIN = 60; // a claim whose chat isn't open and hasn't called gh-coord for this long may have lost its chat
const STACK_GRACE_MS = 30e3; // a db reset restarts the db container: the stack counts as down only after this long gone
const STARTUP_GRACE_MS = 2 * 60e3; // a chat started here that hasn't written a turn by then is stuck
const CLAUDE_DIR = process.env.CLAUDE_CONFIG_DIR || path.join(os.homedir(), '.claude');
const SESSIONS = path.join(CLAUDE_DIR, 'sessions');
const PROJECTS = path.join(CLAUDE_DIR, 'projects');
const LOOPS = ['review', 'fix', 'merge'];
const KINDS = ['review', 'fix', 'merge', 'work', 'tend'];
const ROLES = ['work', 'review', 'fix', 'merge', 'tend'];
const MODES = process.platform === 'darwin' ? ['terminal', 'background', 'vscode'] : ['background', 'vscode'];
const PID_FILE = path.join(STATE, 'dash.pid');
const PORT_FILE = path.join(STATE, 'dash.port');
const LOG_FILE = path.join(STATE, 'dash.log');
const MODE_FILE = path.join(STATE, 'start-mode');
const NAMES_FILE = path.join(STATE, 'names');
// Shared with gh-coord's hooks: a chat started here leaves a starting marker until its first prompt
// or tool call (gh-coord seen) shows it got past its startup dialogs.
const MARKERS = process.env.GREENHOUSE_MARKERS_DIR || `/tmp/greenhouse-agents-${process.getuid()}`;

const ls = (dir) => { try { return fs.readdirSync(dir).filter((n) => !n.startsWith('.')); } catch { return []; } };
const localTime = (s) => (s ? new Date(s.replace(' ', 'T')).getTime() : null);
const within = (p, root) => !!p && !!root && (p === root || p.startsWith(root + '/'));
const inRepo = (p) => !!p && (within(p, MAIN) || p.startsWith(MAIN + '-'));
const alive = (pid) => { try { process.kill(Number(pid), 0); return true; } catch (e) { return e.code === 'EPERM'; } };
const mtimeMs = (f) => { try { return fs.statSync(f).mtimeMs; } catch { return 0; } };
const base = (p) => (p ? p.split('/').filter(Boolean).pop() : null);
const iso = (ms) => (ms ? new Date(ms).toISOString() : null);
// What leaves the machine: `doing` without NAME=value pairs (env values), at most 120 characters.
const sanitize = (s) => (s ? String(s).replace(/\n/g, ' ').replace(/(^|\s)[A-Za-z_][A-Za-z0-9_]*=\S*/g, '$1').replace(/\s+/g, ' ').trim().slice(0, 120) || null : null);

// gh-coord's key=value files, plus the file's mtime (its heartbeat, or a chat's last-seen).
function kvFile(file) {
  try {
    const out = {};
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
      const i = line.indexOf('=');
      if (i > 0) out[line.slice(0, i)] = line.slice(i + 1);
    }
    out.mtime = fs.statSync(file).mtimeMs;
    return out;
  } catch { return null; }
}

function readTail(file, bytes) {
  try {
    const fd = fs.openSync(file, 'r');
    try {
      const { size } = fs.fstatSync(fd);
      const start = Math.max(0, size - bytes);
      const buf = Buffer.alloc(size - start);
      fs.readSync(fd, buf, 0, buf.length, start);
      const text = buf.toString('utf8');
      return start > 0 ? text.slice(text.indexOf('\n') + 1) : text;
    } finally { fs.closeSync(fd); }
  } catch { return ''; }
}

function readHead(file, bytes) {
  try {
    const fd = fs.openSync(file, 'r');
    try { const buf = Buffer.alloc(bytes); return buf.toString('utf8', 0, fs.readSync(fd, buf, 0, bytes, 0)); }
    finally { fs.closeSync(fd); }
  } catch { return ''; }
}

// A chat's transcript: Claude Code files it under the folder it started in, and can move it when the
// chat enters a worktree, so fall back to looking in every project folder.
function transcriptOf(id, hint) {
  if (hint && fs.existsSync(hint)) return hint;
  for (const dir of ls(PROJECTS)) {
    const f = path.join(PROJECTS, dir, `${id}.jsonl`);
    if (fs.existsSync(f)) return f;
  }
  return null;
}

function customTitle(id, cwd) {
  const head = readHead(path.join(PROJECTS, String(cwd).replace(/[^a-zA-Z0-9]/g, '-'), `${id}.jsonl`), 65536);
  const all = [...head.matchAll(/"customTitle":"([^"]*)"/g)];
  return all.length ? all[all.length - 1][1] : null;
}

// Claude Code keeps a file per running chat in ~/.claude/sessions. A name given with -n or /rename
// shows there; a derived one ("greenhouse-92") is replaced by the transcript's custom title if any.
function openChats() {
  return ls(SESSIONS).filter((n) => n.endsWith('.json')).map((n) => {
    try {
      const s = JSON.parse(fs.readFileSync(path.join(SESSIONS, n), 'utf8'));
      if (!alive(s.pid) || !inRepo(s.cwd)) return null;
      if (!s.name || s.nameSource === 'derived') s.name = customTitle(s.sessionId, s.cwd) || s.name;
      return s;
    } catch { return null; }
  }).filter(Boolean);
}

// Busy or idle, as Claude Code itself reports it. `claude agents --json` takes about half a second,
// so it refreshes in the background.
const agents = { status: new Map(), at: 0 };
function refreshAgents() {
  if (Date.now() - agents.at < 10e3) return;
  agents.at = Date.now();
  execFile('claude', ['agents', '--json'], { timeout: 8000, maxBuffer: 4 << 20 }, (err, out) => {
    if (err) return;
    try {
      const m = new Map();
      for (const a of JSON.parse(out)) if (a.sessionId) m.set(a.sessionId, a.status === 'busy' || a.status === 'idle' ? a.status : null);
      agents.status = m;
    } catch {}
  });
}

function locks(now) {
  let db = null;
  if (fs.existsSync(path.join(STATE, 'db.lock'))) {
    const o = kvFile(path.join(STATE, 'db.lock', 'owner')) || {};
    db = {
      label: o.label, path: o.path, purpose: o.purpose, since: localTime(o.since), heartbeat: o.mtime,
      // gh-coord also checks for a process still running in the worktree before breaking it.
      stale: o.path && !fs.existsSync(o.path) ? 'worktree gone'
        : o.mtime && now - o.mtime >= STALE_MIN * 60e3 ? `no heartbeat for ${STALE_MIN}m+` : null,
    };
  }
  const waiting = ls(path.join(STATE, 'db.waiting')).map((name) => {
    let raw = '';
    try { raw = fs.readFileSync(path.join(STATE, 'db.waiting', name), 'utf8').trim(); } catch {}
    const m = raw.match(/^(.*) \(queued (.+?), (.+)\)$/);
    return { label: name.replace(/_/g, '/'), purpose: m ? m[1] : raw, since: m ? localTime(m[2]) : null };
  }).sort((a, b) => (a.since || 0) - (b.since || 0));
  const heavy = [];
  for (let i = 1; i <= HEAVY_SLOTS; i++) {
    const dir = path.join(STATE, 'heavy', `slot${i}`);
    if (!fs.existsSync(dir)) { heavy.push({ slot: i }); continue; }
    const o = kvFile(path.join(dir, 'owner')) || {};
    heavy.push({
      slot: i, held: true, label: o.label, cmd: o.cmd, path: o.path, since: localTime(o.since),
      heartbeat: o.mtime, stale: o.pid && !alive(o.pid) ? 'runner gone' : null,
    });
  }
  return { db, waiting, heavy };
}

// The plugin's Notification hook records what a chat is waiting on (gh-coord needs-you). It's
// answered once the chat writes its transcript again. Loop chats sit idle between ticks, so idle
// only counts for chats that aren't loops.
const NEEDS = { permission_prompt: 'permission', idle_prompt: 'idle', agent_needs_input: 'question', elicitation_dialog: 'question' };
const LOOP_NAME = new RegExp(`^${key}-(review|fix|merge|work) \\d+$`);
const firstTurnSeen = new Set();
// A chat has got going once it calls gh-coord (which writes path=), Claude Code reports a status
// for it, or its transcript has a turn. Some folders (under /tmp) get no transcript or session
// file at all, so the transcript alone can't decide.
function needsOf(o, id, name, now, session) {
  if (o.needs) {
    const kind = NEEDS[o.needs] || 'question';
    const answered = o.transcript && mtimeMs(o.transcript) > Number(o.needs_at) * 1000 + 1000;
    if (!answered && !(kind === 'idle' && LOOP_NAME.test(name || ''))) return kind;
  }
  const going = !!o.path || ['busy', 'idle', 'waiting'].includes(session?.status) || firstTurnSeen.has(id);
  if (o.started_by === 'gh-dash' && o.started && !going && now - Number(o.started) * 1000 > STARTUP_GRACE_MS) {
    const f = transcriptOf(id, o.transcript);
    if (f && readHead(f, 1 << 20).includes('"type":"assistant"')) firstTurnSeen.add(id);
    else return 'startup';
  }
  return null;
}

// One row per claim (with its chat when gh-coord knows it), then chats holding no claim.
function rows(now, { db, waiting, heavy }) {
  const open = new Map(openChats().map((s) => [s.sessionId, s]));
  const chats = ls(path.join(STATE, 'chats')).map((id) => {
    const o = kvFile(path.join(STATE, 'chats', id));
    if (!o) return null;
    const session = open.get(id);
    let name = o.name || session?.name || null;
    // A chat started in VS Code keeps Claude's own title; show it by its claim instead.
    if (o.label && !(name || '').startsWith(`${key}-`)) {
      const [tk, role] = o.label.split('/');
      name = `${tk.toLowerCase()}${role === 'work' ? '' : ` ${role}`}`;
    }
    return {
      id, ticket: o.ticket || null, role: o.role || null, label: o.label || null, lastTicket: o.last_ticket || null,
      doing: o.doing || null, path: o.path || session?.cwd || null, seen: o.mtime, name, since: localTime(o.since),
      open: !!session, status: agents.status.get(id) ?? (session && (session.status === 'busy' || session.status === 'idle') ? session.status : null),
      needs: needsOf(o, id, name, now, session), mode: o.mode || null,
    };
  }).filter(Boolean);
  const used = new Set();
  const out = ls(path.join(STATE, 'claims')).map((ticket) => {
    const c = kvFile(path.join(STATE, 'claims', ticket, 'owner')) || {};
    const worktree = c.path && c.path !== '-' ? c.path : null;
    // A resumed chat re-claims as "already mine", so several chats can carry the ticket in the same
    // role: show the most recently seen one. A chat in another role on the same ticket (a tend chat
    // beside the work chat) keeps its own row.
    const role = (c.label || '').split('/')[1];
    const mine = chats.filter((h) => (c.chat && h.id === c.chat) || (h.ticket === ticket && h.role === role)).sort((a, b) => b.seen - a.seen);
    mine.forEach((h) => used.add(h.id));
    const chat = mine[0] || chats.find((h) => !h.ticket && !used.has(h.id) && within(h.path, worktree));
    if (chat) used.add(chat.id);
    return {
      ticket, label: c.label, role: (c.label || '').split('/')[1] || c.label, claimed: localTime(c.since),
      worktree: worktree || chat?.path || null, chat: chat || null,
    };
  }).sort((a, b) => (b.claimed || 0) - (a.claimed || 0));
  chats.filter((h) => !used.has(h.id) && (h.open || now - h.seen < IDLE_CHAT_MIN * 60e3))
    .sort((a, b) => b.seen - a.seen)
    .forEach((h) => out.push({ ticket: h.ticket, label: h.label, role: h.role, worktree: h.path, chat: h }));
  for (const r of out) {
    const label = r.label || r.chat?.label;
    const q = waiting.findIndex((w) => w.label === label);
    const slots = heavy.filter((s) => label && s.label === label);
    const holdsDb = !!label && db?.label === label;
    r.locks = [...(holdsDb ? ['db'] : []), ...(q >= 0 ? [`db-wait ${q + 1}`] : []), ...slots.map((s) => `slot${s.slot}`)];
    r.doing = r.chat?.doing || (slots[0] && `heavy: ${slots[0].cmd}`) || (holdsDb && `db lock: ${db.purpose}`)
      || (q >= 0 && `waiting for the DB: ${waiting[q].purpose}`) || null;
    // Quiet: the page offers the unclaim line, and the report leaves the chat out, so Greenhouse ends
    // it rather than showing a closed chat as live. Its next gh-coord call brings it back.
    const seen = r.chat ? r.chat.seen : r.claimed;
    r.quiet = r.ticket && seen && !r.chat?.open && now - seen > QUIET_MIN * 60e3 ? now - seen : 0;
  }
  return out;
}

// The stage handoffs the log records. Merges to the integration branch come from git instead.
const FLOW_EVENTS = {
  'claim work': 'start', 'unclaim work': 'handoff', 'claim fix': 'changes', 'unclaim fix': 'fixed', 'claim merge': 'approved',
};

function history(now, current) {
  const lines = readTail(path.join(STATE, 'log'), 256 * 1024).split('\n').map((l) => {
    const m = l.match(/^(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) (.*)$/);
    return m && { ts: localTime(m[1]), msg: m[2] };
  }).filter(Boolean);
  const from = now - TIMELINE_H * 3600e3;
  const lanes = { db: [] };
  for (let i = 1; i <= HEAVY_SLOTS; i++) lanes[`slot${i}`] = [];
  const open = {};
  const flows = { start: [], handoff: [], changes: [], fixed: [], approved: [] };
  const close = (lane, ts, broke) => {
    if (open[lane] && lanes[lane]) lanes[lane].push({ ...open[lane], end: ts, broke });
    delete open[lane];
  };
  for (const { ts, msg } of lines) {
    let m;
    if ((m = msg.match(/^db ACQUIRE (\S+) \((.*)\) (\S+)$/))) { close('db', ts, false); open.db = { label: m[1], what: m[2], start: ts }; }
    else if ((m = msg.match(/^db (RELEASE|BROKE)/))) close('db', ts, m[1] === 'BROKE');
    else if ((m = msg.match(/^heavy ACQUIRE (slot\d+) (\S+) \((.*)\) (\S+)$/))) { close(m[1], ts, false); open[m[1]] = { label: m[2], what: m[3], start: ts }; }
    else if ((m = msg.match(/^heavy (RELEASE|BROKE stale) (slot\d+)/))) close(m[2], ts, m[1] !== 'RELEASE');
    else if ((m = msg.match(/^(claim|unclaim) (\S+) by \S+\/(work|fix|merge)$/)) && ts >= from) {
      const event = FLOW_EVENTS[`${m[1]} ${m[3]}`];
      if (event) flows[event].push({ ticket: m[2], ts });
    }
  }
  // A hold with no release yet is live only if gh-coord still shows that holder.
  if (open.db && current.db?.label === open.db.label) lanes.db.push({ ...open.db, end: now, live: true });
  for (const s of current.heavy) {
    const o = open[`slot${s.slot}`];
    if (o && s.label === o.label) lanes[`slot${s.slot}`].push({ ...o, end: now, live: true });
  }
  return {
    timeline: { from, lanes: Object.entries(lanes).map(([name, segs]) => ({ name, segs: segs.filter((g) => g.end >= from) })) },
    log: lines.slice(-40).reverse(),
    flows,
  };
}

// docker and git are slow next to file reads, so each refreshes in the background: the stack on
// gh-dash's timer (the report needs it), git only while the page asks for state. A db reset restarts the db container, so the stack only counts as down after STACK_GRACE_MS of failed checks.
const stack = { text: LOCAL_STACK ? 'checking' : 'none (no local_stack in the greenhouse block)', dbs: null, at: 0, downSince: null, wasUp: false };
function refreshStack() {
  if (!LOCAL_STACK || Date.now() - stack.at < 5e3) return;
  stack.at = Date.now();
  execFile('docker', ['ps', '--format', '{{.Names}}'], { timeout: 5000 }, (err, out) => {
    const dbs = err ? [] : out.split('\n').map((n) => n.match(/^supabase_db_(.+)$/)?.[1]).filter(Boolean);
    stack.dbs = err ? null : dbs;
    stack.text = err ? 'docker not answering' : dbs.length ? `up (${dbs.join(', ')})` : 'down';
    stack.downSince = dbs.includes(LOCAL_STACK) ? null : stack.downSince || Date.now();
    stack.wasUp = stack.wasUp || dbs.includes(LOCAL_STACK);
  });
}
// What the report says. Like the page, a stack that was up still reads as up for its first
// STACK_GRACE_MS gone, so a db reset doesn't report down and then up again.
function stackState() {
  if (!LOCAL_STACK) return 'none';
  if (stack.dbs?.includes(LOCAL_STACK) || (stack.wasUp && Date.now() - stack.downSince <= STACK_GRACE_MS)) return 'up';
  return stack.dbs?.length ? 'other' : 'down';
}

const midnight = () => new Date().setHours(0, 0, 0, 0);
const TICKET_RE = new RegExp(`\\[(${KEY}-\\d+)\\]`);

// Squash commits on origin/<base> since midnight or the timeline's start, whichever is earlier.
// As fresh as the last fetch any chat made.
const dev = { merged: [], error: null, at: 0 };
function refreshDev() {
  if (Date.now() - dev.at < 30e3) return;
  dev.at = Date.now();
  const since = new Date(Math.min(midnight(), Date.now() - TIMELINE_H * 3600e3)).toISOString();
  execFile('git', ['-C', MAIN, 'log', `origin/${BASE}`, '--first-parent', `--since=${since}`, '--format=%ct%x09%s'],
    { timeout: 5000 }, (err, out) => {
      if (err) { dev.error = `no origin/${BASE} in ${MAIN}`; return; }
      dev.error = null;
      dev.merged = out.split('\n').filter(Boolean).map((l) => {
        const [ct, subject] = l.split('\t');
        return { ts: Number(ct) * 1000, subject, ticket: (subject.match(TICKET_RE) || [])[1] || null };
      });
    });
}

// CPU from os.cpus() deltas on a fixed 2s tick (3 minutes kept for the history strip).
const cpu = { prev: null, pct: null, cores: [], hist: [] };
function sampleCpu() {
  const times = os.cpus().map((c) => c.times);
  const busy = (t) => t.user + t.nice + t.sys + t.irq;
  if (cpu.prev) {
    cpu.cores = times.map((t, i) => {
      const p = cpu.prev[i], d = busy(t) + t.idle - busy(p) - p.idle;
      return d > 0 ? Math.round((busy(t) - busy(p)) / d * 100) : 0;
    });
    cpu.pct = Math.round(cpu.cores.reduce((a, b) => a + b, 0) / cpu.cores.length);
    cpu.hist.push(cpu.pct);
    if (cpu.hist.length > 90) cpu.hist.shift();
  }
  cpu.prev = times;
}

// Memory as Activity Monitor counts it (app + wired + compressed); os.freemem() on macOS only
// counts never-used pages, so it reads near zero. Pressure is memory_pressure's "free percentage".
const mach = { mem: null, swap: null, pressure: null, top: [], at: 0 };
function refreshMachine() {
  if (Date.now() - mach.at < 5e3) return;
  mach.at = Date.now();
  if (process.platform === 'darwin') {
    execFile('vm_stat', { timeout: 3000 }, (err, out) => {
      if (err) return;
      const page = Number((out.match(/page size of (\d+)/) || [])[1] || 16384);
      const n = (k) => Number((out.match(new RegExp(`${k}:\\s+(\\d+)`)) || [])[1] || 0) * page;
      mach.mem = { total: os.totalmem(), used: n('Anonymous pages') - n('Pages purgeable') + n('Pages wired down') + n('Pages occupied by compressor') };
    });
    execFile('sysctl', ['-n', 'vm.swapusage', 'kern.memorystatus_level'], { timeout: 3000 }, (err, out) => {
      if (err) return;
      const [swap, level] = out.trim().split('\n');
      const mb = (k) => Number((swap.match(new RegExp(`${k} = ([\\d.]+)M`)) || [])[1] || 0) * 2 ** 20;
      mach.swap = { total: mb('total'), used: mb('used') };
      mach.pressure = Number(level);
    });
  } else {
    mach.mem = { total: os.totalmem(), used: os.totalmem() - os.freemem() };
  }
  // Grouped by name so a pile of vitest workers reads as one "node" line. Local only: never reported.
  execFile('ps', ['-Ao', 'pcpu=,rss=,comm='], { timeout: 3000, maxBuffer: 8 << 20 }, (err, out) => {
    if (err) return;
    const groups = {};
    for (const line of out.split('\n')) {
      const m = line.trim().match(/^([\d.]+)\s+(\d+)\s+(.+)$/);
      if (!m) continue;
      const name = path.basename(m[3]);
      const g = groups[name] || (groups[name] = { name, cpu: 0, rss: 0, n: 0 });
      g.cpu += Number(m[1]); g.rss += Number(m[2]) * 1024; g.n++;
    }
    mach.top = Object.values(groups).sort((a, b) => b.cpu - a.cpu).slice(0, 6);
  });
}

function machine() {
  let disk = null;
  try { const d = fs.statfsSync(os.homedir()); disk = { free: d.bavail * d.bsize, total: d.blocks * d.bsize }; } catch {}
  return {
    model: os.cpus()[0]?.model, ncpu: os.cpus().length, load: os.loadavg(), pct: cpu.pct, cores: cpu.cores, hist: cpu.hist,
    mem: mach.mem, swap: mach.swap, pressure: mach.pressure, disk, top: mach.top,
  };
}

// ── Starting chats ──────────────────────────────────────────────────────────

function readMode() {
  try { const m = fs.readFileSync(MODE_FILE, 'utf8').trim(); if (MODES.includes(m)) return m; } catch {}
  return MODES[0];
}

// Every name gh-dash gives out stays taken for a day, in the state folder so a restart remembers it.
// Open chats are found by their session files, and a chat that has none (some Claude Code builds,
// folders under /tmp) never shows as open: this is what keeps its name from going out twice. A
// closed chat keeps its number until the day is up, so numbers climb on a busy day.
const NAME_HOLD_MS = 24 * 3600e3;
function givenNames() {
  const out = new Map();
  let text = '';
  try { text = fs.readFileSync(NAMES_FILE, 'utf8'); } catch {}
  for (const line of text.split('\n')) {
    const i = line.indexOf(' ');
    const at = Number(line.slice(0, i));
    if (i > 0 && Date.now() - at < NAME_HOLD_MS) out.set(line.slice(i + 1), at);
  }
  return out;
}
function holdName(name, hold = true) {
  const names = givenNames();
  if (hold) names.set(name, Date.now()); else names.delete(name);
  try { fs.writeFileSync(NAMES_FILE, [...names].map(([n, at]) => `${at} ${n}\n`).join('')); } catch {}
}

// The lowest free name for `base`: loops are always numbered ("<key>-review 1", 2, ...), and a
// ticket's first chat isn't ("<key>-129", then "<key>-129 2").
const takenNames = (open) => new Set([...open.map((s) => s.name), ...givenNames().keys()]);
function freeName(base, taken, numbered) {
  if (!numbered && !taken.has(base)) return base;
  let n = numbered ? 1 : 2;
  while (taken.has(`${base} ${n}`)) n++;
  return `${base} ${n}`;
}
const isNameOf = (name, base) => name === base || (String(name).startsWith(`${base} `) && /^\d+$/.test(name.slice(base.length + 1)));

function nextLoopNames(open) {
  const taken = takenNames(open);
  return Object.fromEntries([...LOOPS, 'work'].map((loop) => [loop, freeName(`${key}-${loop}`, taken, true)]));
}

const sq = (s) => `'${String(s).replace(/'/g, `'\\''`)}'`;
const appleString = (s) => `"${String(s).replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
const osascript = (lines, done) => execFile('osascript', lines.flatMap((l) => ['-e', l]), { timeout: 15000 }, (err) => done(err));

function openTerminal(command, done) {
  osascript(TERMINAL === 'iterm'
    ? ['tell application "iTerm2"', 'activate', 'if (count of windows) = 0 then', 'create window with default profile', 'else',
      'tell current window to create tab with default profile', 'end if', `tell current session of current window to write text ${appleString(command)}`, 'end tell']
    : ['tell application "Terminal"', 'activate', `do script ${appleString(command)}`, 'end tell'], done);
}

// Claude Code puts the chat's name in the terminal title, so the window can be found by it.
function focusTerminal(name, done) {
  osascript(TERMINAL === 'iterm'
    ? ['tell application "iTerm2"', 'activate', 'repeat with w in windows', 'repeat with t in tabs of w',
      `if name of current session of t contains ${appleString(name)} then`, 'select t', 'select w', 'end if', 'end repeat', 'end repeat', 'end tell']
    : ['tell application "Terminal"', 'activate', 'repeat with w in windows',
      `if name of w contains ${appleString(name)} then set index of w to 1`, 'end repeat', 'end tell'], done);
}

function openInVscode(query) {
  // The link opens in whichever VS Code window was used last, so bring this repo's window forward first.
  execFile('code', [MAIN], { timeout: 10000 }, () => setTimeout(() => {
    execFile(process.platform === 'darwin' ? 'open' : 'xdg-open', [`vscode://anthropic.claude-code/open?${query}`]);
  }, 600));
}

// A record for the chat before it ever calls gh-coord, so its card shows at once and a chat that
// never gets going (an untrusted folder, a startup dialog) shows as stuck. gh-coord keeps these keys.
function preRecord(id, name, mode, kind, ticket) {
  const stamp = new Date().toLocaleString('sv-SE').slice(0, 19);
  const lines = [`since=${stamp}`, 'started_by=gh-dash', `started=${Math.floor(Date.now() / 1000)}`, `name=${name}`, `mode=${mode}`];
  // tend never claims, so the record carries its ticket itself.
  if (kind === 'tend' && ticket) lines.push(`ticket=${KEY}-${ticket}`, 'role=tend');
  const record = path.join(STATE, 'chats', id);
  try {
    fs.writeFileSync(record, lines.join('\n') + '\n');
    fs.mkdirSync(path.join(MARKERS, 'starting'), { recursive: true, mode: 0o700 });
    fs.writeFileSync(path.join(MARKERS, 'starting', id), record);
  } catch {}
}

// With a ticket number, the skill runs once on that ticket. Without one, review, fix and merge start
// a numbered 5-minute loop, and work picks the next tended ticket.
function start(kind, ticket, mode, done) {
  if (!KINDS.includes(kind)) return done({ error: `unknown start: ${kind}` });
  if (!MODES.includes(mode)) return done({ error: `unknown mode: ${mode}` });
  if (kind === 'tend' && !ticket) return done({ error: 'enter a ticket number to tend' });
  const open = openChats();
  let name, run;
  if (ticket) {
    const base = kind === 'work' ? `${key}-${ticket}` : `${key}-${ticket} ${kind}`;
    run = kind === 'tend' ? `/greenhouse:tend-ticket ${KEY}-${ticket}` : `/greenhouse:loop-${kind} ${KEY}-${ticket}`;
    // An open chat on this ticket and kind ("<key>-129", "<key>-129 2", ...) comes forward instead.
    const already = open.find((s) => isNameOf(s.name, base));
    if (already) {
      name = already.name;
      if (already.kind === 'bg') return done({ name, already: true, attach: `claude attach ${name}` });
      if (String(already.entrypoint).includes('vscode')) openInVscode(`session=${encodeURIComponent(already.sessionId)}`);
      else if (process.platform === 'darwin') focusTerminal(name, () => {});
      return done({ name, already: true });
    }
    name = freeName(base, takenNames(open), false);
  } else {
    name = nextLoopNames(open)[kind];
    run = kind === 'work' ? '/greenhouse:loop-work' : `/loop 5m /greenhouse:loop-${kind}`;
  }
  holdName(name);
  if (mode === 'vscode') {
    openInVscode(`prompt=${encodeURIComponent(run)}`);
    return done({ name, run, mode, enter: true });
  }
  if (mode === 'terminal') {
    const id = randomUUID();
    preRecord(id, name, mode, kind, ticket);
    const plugin = PLUGIN_DIR ? `--plugin-dir ${sq(PLUGIN_DIR)} ` : '';
    const command = `cd ${sq(MAIN)} && claude ${plugin}-n ${sq(name)} --session-id ${id} --remote-control ${sq(name)} ${sq(run)}`;
    return openTerminal(command, (err) => {
      if (err) { holdName(name, false); try { fs.unlinkSync(path.join(STATE, 'chats', id)); } catch {} return done({ error: `couldn't open ${TERMINAL}: ${err.message.split('\n')[0]}` }); }
      done({ name, run, mode });
    });
  }
  // background: --bg picks its own session id and prints the short form.
  const plugin = PLUGIN_DIR ? ['--plugin-dir', PLUGIN_DIR] : [];
  execFile('claude', ['--bg', ...plugin, '-n', name, '--remote-control', name, run], { cwd: MAIN, timeout: 60000 }, (err, out) => {
    if (err) { holdName(name, false); return done({ error: `claude --bg failed: ${String(err.message).split('\n')[0]}` }); }
    const short = (String(out).match(/backgrounded\s*·\s*([0-9a-f]{8})/) || [])[1];
    if (short) {
      execFile('claude', ['agents', '--json'], { timeout: 8000, maxBuffer: 4 << 20 }, (e, list) => {
        try { const a = JSON.parse(list).find((x) => String(x.sessionId).startsWith(short)); if (a) preRecord(a.sessionId, name, mode, kind, ticket); } catch {}
      });
    }
    done({ name, run, mode, attach: `claude attach ${name}` });
  });
}

// ── Greenhouse: reporting and the start queue ───────────────────────────────

const gh = { creds: null, credsAt: 0, lastSent: 0, lastTry: 0, lastKey: '', state: 'starting', error: null, errorAt: 0, busy: false, polling: false, again: false, started: [], backoffUntil: 0, lastQueueCheck: 0 };
// Answers that won't change on their own: a Greenhouse whose migration hasn't deployed (404), a
// project this token can't reach (403), or a machine name or snapshot the server refuses (400).
// Ask again in five minutes rather than every few seconds.
const BACKOFF_MS = 5 * 60e3;
function backOff(r, fn) {
  if (![400, 403, 404].includes(r.status)) return false;
  gh.backoffUntil = Date.now() + BACKOFF_MS;
  gh.state = 'error';
  ghError(r.status === 404
    ? `${fn} isn't on this Greenhouse yet (its migration hasn't deployed); trying again in 5 minutes`
    : `${fn} refused (HTTP ${r.status}) ${(r.body && r.body.message) || ''}; trying again in 5 minutes`);
  return true;
}

function ghError(msg) {
  gh.error = msg;
  if (Date.now() - gh.errorAt > 60e3) { console.error(`gh-dash: ${msg}`); gh.errorAt = Date.now(); }
}

// gh-jwt caches the session token and refreshes it near expiry, so asking it every minute is cheap.
function credentials(cb) {
  if (gh.creds && Date.now() - gh.credsAt < 60e3) return cb(gh.creds);
  execFile(path.join(BIN, 'gh-jwt'), [], { timeout: 30000 }, (err, out) => {
    if (err) { gh.creds = null; gh.state = 'off'; ghError('no Greenhouse token on this machine: run /greenhouse:setup'); return cb(null); }
    const env = {};
    for (const m of String(out).matchAll(/^export (\w+)='([^']*)'$/gm)) env[m[1]] = m[2];
    gh.creds = env.GREENHOUSE_URL && env.GREENHOUSE_JWT ? env : null;
    gh.credsAt = Date.now();
    cb(gh.creds);
  });
}

async function rpc(fn, body) {
  const c = await new Promise((resolve) => credentials(resolve));
  if (!c) return { ok: false, status: 0, body: null };
  const res = await fetch(`${c.GREENHOUSE_URL}/rest/v1/rpc/${fn}`, {
    method: 'POST',
    headers: { apikey: c.GREENHOUSE_PUBLIC_KEY, Authorization: `Bearer ${c.GREENHOUSE_JWT}`, 'Content-Type': 'application/json' },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(5000),
  });
  const text = await res.text();
  let parsed = null;
  try { parsed = text ? JSON.parse(text) : null; } catch {}
  return { ok: res.ok, status: res.status, body: parsed, text };
}

// What the report reads: the locks and the chat rows, never the page's log history, timeline or
// gauges, so a tick with no page open reads only the coordinator's files and the open chats.
function reportState() {
  const now = Date.now();
  const current = locks(now);
  return { ...current, rows: rows(now, current) };
}

// Exactly what leaves the machine: who is running what. No transcript or prompt text, no paths
// beyond a folder name, no process list, no gauges, and commands with env values stripped.
function reportPayload(s) {
  return {
    p_project_id: PROJECT_ID,
    p_machine: MACHINE,
    p_machine_state: {
      slots_total: HEAVY_SLOTS,
      heavy_slots: s.heavy.filter((h) => h.held).map((h) => ({ slot: h.slot, label: h.label || null, cmd: sanitize(h.cmd) })),
      db_holder: s.db ? s.db.label || null : null,
      db_doing: s.db ? sanitize(s.db.purpose) : null,
      db_waiters: s.waiting.map((w) => w.label),
      stack: stackState(),
      start_mode: readMode(),
    },
    p_chats: s.rows.filter((r) => r.chat && !r.quiet).map((r) => ({
      session_id: r.chat.id,
      name: r.chat.name ? String(r.chat.name).slice(0, 120) : null,
      ticket: r.ticket || null,
      role: ROLES.includes(r.role) ? r.role : null,
      doing: sanitize(r.doing),
      needs_you: r.chat.needs,
      folder: base(r.worktree || r.chat.path),
      started_at: iso(r.chat.since),
    })),
  };
}

// Only when something visible changed, at most every 10 s, failed tries included. There's no
// heartbeat: the queue check below keeps "last seen" fresh. The server ignores a report under 5 s
// after the last and returns false; then this simply tries again on a later tick.
async function reportTick() {
  if (gh.busy || !PROJECT_ID || Date.now() < gh.backoffUntil) { if (!PROJECT_ID) gh.state = 'off'; return; }
  const payload = reportPayload(reportState());
  const key = JSON.stringify(payload);
  if (key === gh.lastKey || Date.now() - gh.lastTry < 10e3) return;
  gh.busy = true;
  gh.lastTry = Date.now();
  try {
    const r = await rpc('report_agent_state', payload);
    if (r.ok) {
      gh.lastSent = Date.now();
      if (r.body === true) { gh.lastKey = key; gh.state = 'reporting'; gh.error = null; }
    } else if (backOff(r, 'report_agent_state')) { /* backed off */ }
    else if (r.status) { gh.state = 'error'; ghError(`report_agent_state failed (HTTP ${r.status}) ${(r.body && r.body.message) || ''}`.trim()); }
  } catch (e) { gh.state = 'error'; ghError(`report_agent_state failed: ${e.message}`); }
  finally { gh.busy = false; }
}

// A clean stop: every chat on this machine ends and it shows as stopped, rather than waiting ten
// silent minutes to read as offline.
async function stopReport() {
  if (!PROJECT_ID || !gh.creds) return;
  try { await rpc('report_agent_state', { ...reportPayload(reportState()), p_chats: [], p_stopping: true }); } catch {}
}

// Requests queued from a ticket page for this machine, taken until none is left. VS Code mode needs
// someone at the keyboard to press Enter, so queued starts always run in terminal (or background,
// when that's the mode). A nudge that arrives while a start runs asks for another pass, so a second
// request queued meanwhile is taken right after, not at the next safety-net check.
async function queueTick() {
  if (!PROJECT_ID || !gh.creds || Date.now() < gh.backoffUntil) return;
  if (gh.polling) { gh.again = true; return; }
  gh.polling = true;
  try {
    let req;
    do {
      gh.again = false;
      gh.lastQueueCheck = Date.now();
      const r = await rpc('take_agent_start', { p_project_id: PROJECT_ID, p_machine: MACHINE });
      if (!r.ok && backOff(r, 'take_agent_start')) return;
      req = r.ok && Array.isArray(r.body) ? r.body[0] : null;
      if (req) {
        const mode = readMode() === 'background' || !MODES.includes('terminal') ? 'background' : 'terminal';
        const ticket = req.ticket_number ? String(req.ticket_number) : '';
        const out = await new Promise((resolve) => start(req.kind, ticket, mode, resolve));
        gh.started.unshift({ at: Date.now(), kind: req.kind, ticket, name: out.name, error: out.error || null });
        gh.started.length = Math.min(gh.started.length, 5);
        await rpc('finish_agent_start', { p_id: req.id, p_status: out.error ? 'failed' : 'done', p_reason: out.error || (out.already ? `${out.name} was already open` : null) });
      }
    } while (req || gh.again);
  } catch (e) { ghError(`take_agent_start failed: ${e.message}`); }
  finally { gh.polling = false; }
}

// Starts pushed from Greenhouse. gh-dash joins one private Realtime topic, agents-queue:<username>,
// which only that person can join, and checks the queue when nudged and whenever it (re)joins.
// Realtime's JSON protocol (vsn 1.0.0) by hand: a plugin ships no node_modules. The safety-net
// check runs every 4 minutes while joined (it also stamps "last seen"), and every 60 s when the
// socket can't connect.
const rt = { ws: null, joined: false, ref: 0, joinRef: null, topic: null, token: null, beat: null, retryMs: 5e3, closing: false };

function rtSend(event, payload, topic = rt.topic, joinRef = rt.joinRef) {
  if (rt.ws && rt.ws.readyState === 1) rt.ws.send(JSON.stringify({ topic, event, payload, ref: String(++rt.ref), join_ref: joinRef }));
}

function rtConnect() {
  if (rt.closing || rt.ws) return;
  credentials((c) => {
    if (!c || !c.GREENHOUSE_TEAM_USERNAME || typeof WebSocket !== 'function') { setTimeout(rtConnect, 60e3); return; }
    const url = `${c.GREENHOUSE_URL.replace(/^http/, 'ws')}/realtime/v1/websocket?apikey=${encodeURIComponent(c.GREENHOUSE_PUBLIC_KEY)}&vsn=1.0.0`;
    const ws = new WebSocket(url);
    rt.ws = ws;
    rt.topic = `realtime:agents-queue:${c.GREENHOUSE_TEAM_USERNAME}`;
    rt.token = c.GREENHOUSE_JWT;
    ws.addEventListener('open', () => {
      rt.joinRef = String(++rt.ref);
      ws.send(JSON.stringify({
        topic: rt.topic, event: 'phx_join', ref: rt.joinRef, join_ref: rt.joinRef,
        payload: { config: { broadcast: { self: false }, presence: { key: '', enabled: false }, postgres_changes: [], private: true }, access_token: rt.token },
      }));
      rt.beat = setInterval(() => rtSend('heartbeat', {}, 'phoenix', null), 25e3);
    });
    ws.addEventListener('message', (e) => {
      let m;
      try { m = JSON.parse(e.data); } catch { return; }
      if (m.topic !== rt.topic) return;
      if (m.event === 'phx_reply' && m.ref === rt.joinRef) {
        if (m.payload && m.payload.status === 'ok') { rt.joined = true; rt.retryMs = 5e3; void queueTick(); }
        else { ghError(`realtime: couldn't join the queue topic: ${JSON.stringify((m.payload && m.payload.response) || {})}`); ws.close(); }
      } else if (m.event === 'broadcast' && m.payload && m.payload.event === 'start-queued') {
        void queueTick();
      } else if (m.event === 'phx_close' || m.event === 'phx_error') {
        ws.close();
      }
    });
    ws.addEventListener('close', () => {
      clearInterval(rt.beat);
      rt.ws = null;
      rt.joined = false;
      if (rt.closing) return;
      setTimeout(rtConnect, rt.retryMs);
      rt.retryMs = Math.min(rt.retryMs * 2, 60e3);
    });
    ws.addEventListener('error', () => {});
  });
}

// gh-jwt refreshes the session token near expiry; hand the new one to the socket.
function rtRefreshToken() {
  if (!rt.joined) return;
  credentials((c) => {
    if (c && c.GREENHOUSE_JWT !== rt.token) { rt.token = c.GREENHOUSE_JWT; rtSend('access_token', { access_token: rt.token }); }
  });
}

function queueSafetyNet() {
  if (Date.now() - gh.lastQueueCheck >= (rt.joined ? 4 * 60e3 : 60e3)) void queueTick();
}

// ── Server ──────────────────────────────────────────────────────────────────

let PORT = BASE_PORT;

function snapshot() {
  const now = Date.now();
  const current = locks(now);
  const hist = history(now, current);
  hist.flows.landed = dev.merged.filter((m) => m.ts >= hist.timeline.from)
    .map((m) => ({ ticket: m.ticket || '-', ts: m.ts })).sort((a, b) => a.ts - b.ts);
  return {
    now, key, KEY, base: BASE, machineName: MACHINE, localStack: LOCAL_STACK,
    stack: stack.text, stackDown: !!LOCAL_STACK && !!stack.downSince && now - stack.downSince > STACK_GRACE_MS,
    dev: { merged: dev.merged.filter((m) => m.ts >= midnight()), error: dev.error },
    ...current, rows: rows(now, current), ...hist, machine: machine(), starts: nextLoopNames(openChats()),
    modes: MODES, mode: readMode(),
    greenhouse: { state: gh.state, lastSent: gh.lastSent || null, error: gh.error, started: gh.started, live: rt.joined },
  };
}

function readBody(req, cb) {
  let body = '';
  req.on('data', (c) => { body += c; if (body.length > 1024) req.destroy(); });
  req.on('end', () => { let q = {}; try { q = JSON.parse(body); } catch {} cb(q); });
}

const server = http.createServer((req, res) => {
  // Only answer to our own hostnames: chat state stays off-limits to pages that rebind DNS.
  if (![`127.0.0.1:${PORT}`, `localhost:${PORT}`].includes(req.headers.host)) { res.writeHead(403); return res.end(); }
  const json = (code, o) => { res.writeHead(code, { 'content-type': 'application/json', 'cache-control': 'no-store' }); res.end(JSON.stringify(o)); };
  if (req.url === '/api/state') {
    refreshStack(); refreshDev(); refreshMachine(); refreshAgents();
    return json(200, snapshot());
  }
  if ((req.url === '/api/start' || req.url === '/api/mode') && req.method === 'POST') {
    // Only this page can start chats: a form on another site can't set this header, and another
    // site's fetch with it needs a CORS preflight this server never answers.
    if (req.headers['x-gh-dash'] !== '1') { res.writeHead(403); return res.end(); }
    return readBody(req, (q) => {
      if (req.url === '/api/mode') {
        if (!MODES.includes(q.mode)) return json(400, { error: `unknown mode: ${q.mode}` });
        try { fs.writeFileSync(MODE_FILE, `${q.mode}\n`); } catch (e) { return json(500, { error: e.message }); }
        return json(200, { mode: q.mode });
      }
      start(String(q.kind), /^\d{1,6}$/.test(q.ticket) ? q.ticket : '', readMode(), (out) => json(out.error ? 400 : 200, out));
    });
  }
  if (req.url === '/') {
    res.writeHead(200, { 'content-type': 'text/html; charset=utf-8' });
    return res.end(PAGE);
  }
  res.writeHead(404); res.end();
});

function running() {
  try {
    const pid = Number(fs.readFileSync(PID_FILE, 'utf8'));
    const port = Number(fs.readFileSync(PORT_FILE, 'utf8'));
    return pid && pid !== process.pid && alive(pid) ? { pid, port } : null;
  } catch { return null; }
}
const openBrowser = (url) => execFile(process.platform === 'darwin' ? 'open' : 'xdg-open', [url]);

function listen(port, tries) {
  server.once('error', (e) => {
    if (e.code === 'EADDRINUSE' && tries > 0) return listen(port + 1, tries - 1);
    console.error(`gh-dash: ${e.message}`);
    process.exit(1);
  });
  server.listen(port, '127.0.0.1', () => {
    PORT = port;
    fs.writeFileSync(PID_FILE, String(process.pid));
    fs.writeFileSync(PORT_FILE, String(port));
    // Only the stack feeds the report. The page's own readings (git, processes, memory, Claude's
    // busy/idle) refresh when it asks for state, so nothing spawns while nobody has it open.
    refreshStack();
    sampleCpu(); setInterval(sampleCpu, 2000);
    setInterval(() => { refreshStack(); void reportTick(); }, 2000);
    setInterval(queueSafetyNet, 5000);
    setInterval(rtRefreshToken, 60e3);
    rtConnect();
    const url = `http://127.0.0.1:${port}`;
    console.log(`gh-dash: ${url}  (${KEY}, reading ${STATE}, machine ${MACHINE})`);
    if (ARGS.includes('--open')) openBrowser(url);
  });
}

function cleanup() {
  try { if (Number(fs.readFileSync(PID_FILE, 'utf8')) === process.pid) { fs.unlinkSync(PID_FILE); fs.unlinkSync(PORT_FILE); } } catch {}
}

if (process.env.GREENHOUSE_ENV_PROBE) {
  // Test hook (plugin/tests/gh-coord.test.sh): what a started chat would inherit from gh-dash.
  const left = Object.keys(process.env).filter((n) => n === 'CLAUDECODE' || n.startsWith('CLAUDE_CODE_'));
  if (left.length) console.error(left.join(' '));
}
if (ARGS.includes('--report-preview')) {
  // One stack check (the report's only spawned reading), then print the payload. No network.
  refreshStack();
  setTimeout(() => { console.log(JSON.stringify(reportPayload(reportState()), null, 2)); process.exit(0); }, 2500);
} else {
  const already = running();
  if (already) {
    console.log(`gh-dash: already running for ${KEY} at http://127.0.0.1:${already.port} (pid ${already.pid})`);
    if (ARGS.includes('--open')) openBrowser(`http://127.0.0.1:${already.port}`);
  } else if (ARGS.includes('--detach')) {
    const log = fs.openSync(LOG_FILE, 'a');
    spawn(process.execPath, [__filename, ...ARGS.filter((a) => a !== '--detach')], { detached: true, stdio: ['ignore', log, log], cwd: MAIN }).unref();
    const until = Date.now() + 5000;
    (function wait() {
      const r = running();
      if (r) { console.log(`gh-dash: started for ${KEY} at http://127.0.0.1:${r.port} (log ${LOG_FILE})`); process.exit(0); }
      if (Date.now() > until) { console.log(`gh-dash: starting in the background; see ${LOG_FILE}`); process.exit(0); }
      setTimeout(wait, 200);
    })();
  } else {
    process.on('exit', cleanup);
    // A clean stop tells Greenhouse (at most 3 s), so the machine's chats end at once.
    const shutdown = () => {
      rt.closing = true;
      try { if (rt.ws) rt.ws.close(); } catch {}
      setTimeout(() => process.exit(0), 3000);
      void stopReport().finally(() => process.exit(0));
    };
    process.on('SIGINT', shutdown);
    process.on('SIGTERM', shutdown);
    listen(BASE_PORT, 9);
  }
}

