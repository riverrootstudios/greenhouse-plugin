<script>
var $ = function (id) { return document.getElementById(id); };
var ROLES = ['work', 'review', 'fix', 'merge'];
var LOOPS = ['review', 'fix', 'merge'];
var KEY = 'GH', key = 'gh';
var NEEDS_TEXT = { permission: 'needs you: permission', question: 'needs you: question', idle: 'needs you: idle', startup: 'needs you: stuck at startup' };
// One arrow per handoff. The last one is a squash commit on the integration branch, the rest are log events.
function flowText(k) {
  return {
    start: 'claim ' + KEY + '-n/work: a work chat started the ticket',
    handoff: 'unclaim ' + KEY + '-n/work: PR opened, off to review',
    changes: 'claim ' + KEY + '-n/fix: changes requested, a fix chat took it',
    fixed: 'unclaim ' + KEY + '-n/fix: fixes pushed, back to review',
    approved: 'claim ' + KEY + '-n/merge: approved, a merge chat took it',
    landed: 'squash commit on the integration branch'
  }[k];
}
var FLOWS = ['start', 'handoff', 'changes', 'fixed', 'approved', 'landed'];

function esc(s) {
  return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c];
  });
}
function pad2(n) { return String(n).padStart(2, '0'); }
function ago(ms) {
  if (ms == null || isNaN(ms)) return '-';
  var s = Math.max(0, Math.round(ms / 1000));
  if (s < 60) return s + 's';
  var m = Math.floor(s / 60);
  if (m < 60) return m + 'm';
  return Math.floor(m / 60) + 'h' + pad2(m % 60);
}
function hhmm(t) { var d = new Date(t); return pad2(d.getHours()) + ':' + pad2(d.getMinutes()); }
function base(p) { return p ? p.split('/').filter(Boolean).pop() : '-'; }
function starts(s, prefix) { return !!s && s.indexOf(prefix) === 0; }
function lamp(cls, text) { return '<span class="lampx ' + cls + '"><i class="lamp"></i><b class="st">' + text + '</b></span>'; }
function gb(b) { return (b / 1073741824).toFixed(1); }
function meter(pct, hot) {
  var h = '';
  for (var i = 0; i < 20; i++) h += '<i' + (i < Math.round(pct / 5) ? ' class="on"' : '') + '></i>';
  return '<div class="meter' + (hot ? ' hot' : '') + '">' + h + '</div>';
}
function tag(lock) { return '<span class="tag ' + (starts(lock, 'slot') ? 'g' : 'a') + '">' + esc(lock) + '</span>'; }

// The lamp shows what the chat needs first, then what gh-coord can see: waiting on a lock, running
// under one, just claimed, or quiet (r.quiet, the same rule the report uses).
function cardState(r) {
  if (r.chat && r.chat.needs) return ['s-need', 'NEEDS YOU'];
  if (r.locks.some(function (l) { return starts(l, 'db-wait'); }) || starts(r.doing, 'waiting')) return ['s-wait', 'WAIT'];
  if (r.locks.indexOf('db') >= 0 || starts(r.doing, 'db')) return ['s-run', 'DB'];
  if (r.locks.some(function (l) { return starts(l, 'slot'); }) || starts(r.doing, 'heavy')) return ['s-run', 'HEAVY'];
  if (r.quiet) return ['s-quiet', 'QUIET'];
  if (r.ticket) return ['s-act', 'CLAIMED'];
  return ['', 'IDLE'];
}

function card(r, now) {
  var st = cardState(r), seen = r.chat ? now - r.chat.seen : null, quiet = r.quiet;
  var needs = r.chat && r.chat.needs ? NEEDS_TEXT[r.chat.needs] : '';
  var doing = needs || r.doing || (quiet ? 'silent ' + ago(quiet) : '');
  var name = r.chat && r.chat.name;
  var unclaim = quiet && !r.doing ? '<div class="card-fix" title="run this if the chat is gone">gh-coord unclaim ' + esc(r.ticket + ' ' + r.label) + '</div>' : '';
  var last = !r.ticket && r.chat && r.chat.lastTicket ? '<span>last ' + esc(r.chat.lastTicket) + '</span>' : '';
  var status = r.chat && r.chat.status ? '<span class="tag ' + (r.chat.status === 'busy' ? 'g' : 'd') + '">' + r.chat.status + '</span>' : '';
  return '<div class="card ' + st[0] + '">' +
    '<div class="card-top"><i class="lamp"></i><b class="st">' + st[1] + '</b>' +
    '<span class="tk">' + esc(r.ticket || name || r.label || 'chat') + '</span>' +
    '<span class="age" title="claimed this long ago">' + (r.claimed ? ago(now - r.claimed) : '') + '</span></div>' +
    (r.ticket && name ? '<div class="card-name" title="chat name">' + esc(name) + '</div>' : '') +
    (doing ? '<div class="card-do' + (needs ? ' a' : r.doing ? '' : ' d') + '" title="' + esc(doing) + '">' + esc(doing) + '</div>' : '') + unclaim +
    '<div class="card-meta">' + status + r.locks.map(tag).join('') + last + '<span>' + esc(base(r.worktree)) + '</span>' +
    '<span title="last gh-coord call from this chat">seen ' + (seen == null ? '-' : ago(seen)) + '</span></div>' +
    '</div>';
}

function renderStages(s) {
  var by = { idle: [], work: [], review: [], fix: [], merge: [] };
  s.rows.forEach(function (r) { by[r.ticket && ROLES.indexOf(r.role) >= 0 ? r.role : 'idle'].push(r); });
  Object.keys(by).forEach(function (k) {
    var el = $('st-' + k), list = by[k];
    el.classList.toggle('live', k !== 'idle' && list.length > 0);
    el.querySelector('.count').textContent = pad2(list.length);
    el.querySelector('.cards').innerHTML = list.length
      ? list.map(function (r) { return card(r, s.now); }).join('')
      : '<div class="empty">none</div>';
  });
  var merged = s.dev.merged, el = $('st-dev');
  $('base-name').textContent = s.base;
  el.classList.toggle('live', merged.length > 0);
  el.querySelector('.count').textContent = pad2(merged.length);
  var list = el.querySelector('.cards'), scroll = list.scrollTop;
  var suffix = new RegExp(' \\[' + KEY + '-\\d+\\]$');
  list.innerHTML = s.dev.error
    ? '<div class="empty">' + esc(s.dev.error) + '</div>'
    : merged.length
      ? merged.map(function (m) {
          return '<div class="merge" title="' + esc(m.subject) + '"><span class="d">' + hhmm(m.ts) + '</span><span class="hi">' +
            esc(m.ticket || '-') + '</span><span class="subj">' + esc(m.subject.replace(/^\w+: /, '').replace(suffix, '')) + '</span></div>';
        }).join('')
      : '<div class="empty">none</div>';
  list.scrollTop = scroll;
}

function renderFlows(s) {
  FLOWS.forEach(function (k) {
    var el = $('f-' + k), ev = s.flows[k] || [], last = ev.length ? ev[ev.length - 1].ts : null;
    el.classList.toggle('lit', ev.length > 0);
    el.classList.toggle('hot', last != null && s.now - last < 10 * 60e3);
    el.querySelector('.n').textContent = ev.length || '';
    el.title = flowText(k) + '\n' + (ev.length
      ? ev.slice(-10).reverse().map(function (e) { return hhmm(e.ts) + '  ' + e.ticket; }).join('\n')
      : 'none in the last 6h');
  });
}

function renderAlerts(s) {
  var busy = s.heavy.filter(function (h) { return h.held; }).length;
  var stale = (s.db && s.db.stale) || s.heavy.some(function (h) { return h.stale; });
  var needing = s.rows.filter(function (r) { return r.chat && r.chat.needs; }).length;
  var tiles = [
    ['NEEDS YOU' + (needing ? ' ' + needing : ''), needing > 0, 'a'],
    ['DB LOCK HELD', !!s.db, 'a'],
    ['DB-WAIT' + (s.waiting.length ? ' ' + s.waiting.length : ''), s.waiting.length > 0, 'a'],
    ['HEAVY FULL', s.heavy.length > 0 && busy === s.heavy.length, 'a'],
    ['STALE LOCK', !!stale, 'r'],
    ['STACK DOWN', s.stackDown, 'r'],
    ['MEM PRESSURE', memTight(s.machine), 'a'],
    ['DISK LOW', diskLow(s.machine), 'r'],
    ['MERGED' + (s.dev.merged.length ? ' ' + s.dev.merged.length : ''), s.dev.merged.length > 0, 'g']
  ];
  $('alerts').innerHTML = tiles.map(function (t) {
    return '<div class="tile' + (t[1] ? ' on-' + t[2] : '') + '">' + esc(t[0]) + '</div>';
  }).join('');
}

function memTight(m) { return m.pressure != null && m.pressure < 20; }
function diskLow(m) { return !!m.disk && m.disk.free < 20 * 1073741824; }

// Redrawn on every poll, apart from the keyed redraw below, since CPU changes every tick.
function renderMachine(s) {
  var m = s.machine;
  var hist = new Array(Math.max(0, 90 - m.hist.length)).fill(null).concat(m.hist);
  $('m-cpu').title = (m.model || '') + ', ' + m.ncpu + ' cores. Bars: each core now, then the last 3 minutes.';
  $('m-cpu').innerHTML =
    '<div class="row"><span class="name">CPU</span><span class="val">' + (m.pct == null ? '-' : m.pct + '%') + '</span>' +
    '<span class="sm">load ' + m.load.map(function (l) { return l.toFixed(1); }).join(' ') + '</span></div>' +
    '<div class="cores">' + m.cores.map(function (p) {
      return '<i><b' + (p >= 90 ? ' class="hot"' : '') + ' style="height:' + p + '%"></b></i>';
    }).join('') + '</div>' +
    '<div class="spark">' + hist.map(function (p) {
      return p == null ? '<i style="height:0"></i>' : '<i' + (p >= 90 ? ' class="hot"' : '') + ' style="height:' + Math.max(p, 4) + '%"></i>';
    }).join('') + '</div>';
  $('m-mem').innerHTML = !m.mem ? '<div class="row"><span class="name">MEM</span><span class="sm">reading</span></div>' :
    '<div class="row"><span class="name">MEM</span><span class="val">' + gb(m.mem.used) + ' / ' + gb(m.mem.total) + ' GB</span>' +
    (m.pressure != null ? '<span class="sm' + (memTight(m) ? ' a' : '') + '">pressure ' + m.pressure + '% free</span>' : '') + '</div>' +
    meter(m.mem.used / m.mem.total * 100, memTight(m)) +
    '<div class="row foot">' + (m.swap && m.swap.total ? '<span>swap ' + gb(m.swap.used) + ' / ' + gb(m.swap.total) + ' GB</span>' : '<span></span>') +
    (m.disk ? '<span class="' + (diskLow(m) ? 'r' : '') + '">disk ' + gb(m.disk.free) + ' GB free</span>' : '') + '</div>';
  $('m-top').innerHTML = m.top.map(function (p) {
    return '<div class="proc"><div><span class="hi">' + esc(p.name) + '</span>' + (p.n > 1 ? ' <span class="d">&times;' + p.n + '</span>' : '') + '</div>' +
      '<div><span class="' + (p.cpu >= 100 ? 'a' : '') + '">' + Math.round(p.cpu) + '%</span> <span class="d">&middot; ' + gb(p.rss) + ' GB</span></div></div>';
  }).join('') || '<div class="d">reading</div>';
}

function dbLoad(s) {
  var from = s.timeline.from, span = s.now - from, held = 0, longest = 0, segs = s.timeline.lanes[0].segs;
  segs.forEach(function (g) { held += g.end - Math.max(g.start, from); longest = Math.max(longest, g.end - g.start); });
  return { pct: Math.round(held / span * 100), holds: segs.length, longest: longest };
}

function renderLocks(s) {
  var h = '', load = dbLoad(s);
  if (!s.localStack) h += '<div class="line">' + lamp('', 'OFF') + '<span class="d">no local_stack in the greenhouse block</span></div>';
  else if (s.db) {
    h += '<div class="line">' + (s.db.stale ? lamp('s-alarm', 'STALE') : lamp('s-held', 'HELD')) +
      '<span class="hi">' + esc(s.db.label) + '</span><span class="d">' + ago(s.now - s.db.since) + ' &middot; heartbeat ' + ago(s.now - s.db.heartbeat) + '</span></div>' +
      '<div class="d">' + esc(s.db.purpose) + (s.db.stale ? ' <span class="r">(' + esc(s.db.stale) + ')</span>' : '') + '</div>';
  } else h += '<div class="line">' + lamp('s-run', 'FREE') + '</div>';
  h += '<div class="line" style="margin-top:8px"><span class="k">db-wait</span>' + (s.waiting.length ? '' : '<span class="d">none</span>') + '</div>';
  s.waiting.forEach(function (w, i) {
    h += '<div class="line">' + lamp('s-wait', String(i + 1)) + '<span class="hi">' + esc(w.label) + '</span><span class="d">' + ago(s.now - w.since) + ' &middot; ' + esc(w.purpose) + '</span></div>';
  });
  h += '<div class="line" style="margin-top:8px"><span class="k">load 6h</span><span class="hi">' + load.pct + '%</span><span class="d">' + load.holds + ' holds &middot; longest ' + ago(load.longest) + '</span></div>' +
    meter(load.pct, load.pct >= 75);
  $('sys-db').innerHTML = h;

  $('sys-heavy').innerHTML = s.heavy.map(function (p) {
    if (!p.held) return '<div class="line"><span class="k">slot' + p.slot + '</span>' + lamp('', 'FREE') + '</div>';
    return '<div class="line"><span class="k">slot' + p.slot + '</span>' + (p.stale ? lamp('s-alarm', 'STALE') : lamp('s-run', 'BUSY')) +
      '<span class="hi">' + esc(p.label) + '</span><span class="d">' + ago(s.now - p.since) + '</span></div>' +
      '<div class="d" style="margin:0 0 6px 7ch;padding-left:10px">' + esc(p.cmd) + (p.stale ? ' <span class="r">(' + esc(p.stale) + ')</span>' : '') + '</div>';
  }).join('');

  var up = starts(s.stack, 'up');
  var claimed = s.rows.filter(function (r) { return r.claimed; }).length;
  $('sys-stack').innerHTML =
    '<div class="line"><span class="k">db-stack</span>' + (!s.localStack ? lamp('', 'NONE') : up ? lamp('s-run', 'UP') : s.stackDown ? lamp('s-alarm', 'DOWN') : lamp('', '...')) + '<span class="d">' + esc(s.stack) + '</span></div>' +
    '<div class="line"><span class="k">chats</span><span class="hi">' + claimed + '</span><span class="d">claimed</span><span class="hi">' + (s.rows.length - claimed) + '</span><span class="d">idle</span></div>' +
    '<div class="line"><span class="k">machine</span><span class="d">' + esc(s.machineName) + '</span></div>';
}

function renderTimeline(s) {
  var from = s.timeline.from, span = s.now - from, grid = '', axis = '';
  for (var t = Math.ceil(from / 3600e3) * 3600e3; t < s.now; t += 3600e3) {
    var x = (t - from) / span * 100;
    grid += '<i class="gl" style="left:' + x + '%"></i>';
    axis += '<span style="left:' + x + '%">' + hhmm(t) + '</span>';
  }
  var h = s.timeline.lanes.map(function (lane) {
    var segs = lane.segs.map(function (g) {
      var a = Math.max(g.start, from), left = (a - from) / span * 100, width = Math.max(0.3, (g.end - a) / span * 100);
      var tk = String(g.label || '').split('/')[0];
      var tip = g.label + '  ' + hhmm(g.start) + '-' + (g.live ? 'now' : hhmm(g.end)) + ' (' + ago(g.end - g.start) + ')' +
        (g.broke ? '  broken as stale' : '') + '\n' + g.what;
      return '<div class="seg' + (g.live ? ' live' : '') + (g.broke ? ' broke' : '') + '" style="left:' + left + '%;width:' + width + '%" title="' +
        esc(tip) + '">' + (width >= 2 ? esc(tk.replace(KEY + '-', '')) : '') + '</div>';
    }).join('');
    return '<div class="lane"><span>' + esc(lane.name) + '</span><div class="track">' + grid + segs + '</div></div>';
  }).join('');
  $('chart').innerHTML = h + '<div class="axis">' + axis + '</div>';
}

function renderLog(s) {
  $('log').innerHTML = s.log.map(function (l) {
    var m = l.msg, cls = /BROKE/.test(m) ? 'r' : /ACQUIRE|^claim/.test(m) ? 'g' : /RELEASE|^unclaim/.test(m) ? 'd' : '';
    return '<div><span class="d">' + hhmm(l.ts) + '</span> <span class="' + cls + '">' + esc(m) + '</span></div>';
  }).join('') || '<div class="d">empty</div>';
}

function renderGreenhouse(s) {
  var g = s.greenhouse, el = $('gh');
  if (g.state === 'reporting') { el.className = 'g'; el.textContent = 'GREENHOUSE ' + (g.live ? 'LIVE' : 'POLLING'); }
  else if (g.state === 'off') { el.className = 'a'; el.textContent = 'GREENHOUSE OFF'; }
  else if (g.state === 'error') { el.className = 'r'; el.textContent = 'GREENHOUSE ERROR'; }
  else { el.className = 'd'; el.textContent = 'GREENHOUSE ...'; }
  el.title = g.error || (g.state === 'reporting' ? 'reports this machine\'s chats when they change (last ' + ago(s.now - g.lastSent) + ' ago); ' +
    (g.live ? 'starts from ticket pages arrive at once' : 'checking for starts every minute (no realtime connection)') : '');
}

// The start buttons and the mode switch.
var hintTimer;
function hint(cls, text) {
  $('hint').className = 'hint ' + cls;
  $('hint').textContent = text;
  clearTimeout(hintTimer);
  hintTimer = setTimeout(function () { $('hint').textContent = ''; }, 30000);
}
function post(url, body) {
  return fetch(url, { method: 'POST', headers: { 'content-type': 'application/json', 'x-gh-dash': '1' }, body: JSON.stringify(body) })
    .then(function (r) { return r.json(); });
}
function start(kind) {
  hint('d', 'opening a chat...');
  post('/api/start', { kind: kind, ticket: $('tk').value.replace(/\D/g, '') })
    .then(function (o) {
      if (o.error) hint('r', o.error);
      else if (o.already) hint('g', o.name + ' is already open' + (o.attach ? ': ' + o.attach : ': showing it'));
      else if (o.enter) hint('a', 'open in VS Code: press Enter to run ' + o.run);
      else if (o.mode === 'background') hint('g', o.name + ' is running in the background: ' + o.attach);
      else hint('g', o.name + ' is running in a new terminal: ' + o.run);
    })
    .catch(function () { hint('r', 'gh-dash is not answering'); });
}
$('launch').addEventListener('click', function (e) {
  var b = e.target.closest('button');
  if (b) start(b.getAttribute('data-kind'));
});
var MODE_TIPS = {
  terminal: 'a new terminal window, named, runs with no Enter, and shows in the Claude app (Remote Control)',
  background: 'claude --bg: named, runs with no Enter, no window; claude attach <name> opens it, the Claude app shows it',
  vscode: 'a VS Code tab with the command typed in: press Enter to run it'
};
var currentMode = '', modesKey = '';
function renderModes(s) {
  currentMode = s.mode;
  var k = s.modes.join(',') + '|' + s.mode;
  if (k === modesKey) return;
  modesKey = k;
  $('modes').innerHTML = '<span class="d">start in</span>' + s.modes.map(function (m) {
    return '<button data-mode="' + m + '" class="' + (m === s.mode ? 'on' : '') + '" title="' + esc(MODE_TIPS[m]) + '">' + m + '</button>';
  }).join('');
}
$('modes').addEventListener('click', function (e) {
  var b = e.target.closest('button');
  if (!b) return;
  post('/api/mode', { mode: b.getAttribute('data-mode') })
    .then(function (o) { if (o.error) hint('r', o.error); else { modesKey = ''; hint('d', 'starts now open in ' + o.mode + ' mode'); tick(); } });
});
// The buttons say what a click starts: with a number, one pass of the skill on that ticket; without
// one, a numbered loop for review, fix and merge, and work picks the next tended ticket.
var nextNames = {};
function labelStarts() {
  var n = $('tk').value.replace(/\D/g, '');
  ['review', 'fix', 'merge', 'work', 'tend'].forEach(function (k) {
    var b = document.querySelector('[data-kind="' + k + '"]'), loop = LOOPS.indexOf(k) >= 0;
    b.textContent = k + ' ' + (n || (loop ? 'loop' : k === 'work' ? 'next' : ''));
    b.disabled = k === 'tend' && !n;
    b.title = n
      ? 'new chat ' + key + '-' + n + (k === 'work' ? '' : ' ' + k) + ' running ' + (k === 'tend' ? '/greenhouse:tend-ticket' : '/greenhouse:loop-' + k) + ' ' + KEY + '-' + n +
        (k === 'merge' ? '\none pass: if CI is still running, a merge loop lands it' : '')
      : loop ? 'new chat ' + (nextNames[k] || key + '-' + k + ' n') + ' running /loop 5m /greenhouse:loop-' + k
      : k === 'work' ? 'new chat ' + (nextNames.work || key + '-work n') + ' running /greenhouse:loop-work; it picks the next tended ticket'
      : 'enter a ticket number to tend';
  });
}
function setTicket(v) {
  var t = $('tk');
  t.value = v.replace(/\D/g, '').slice(0, 6);
  t.style.width = t.value.length + 'ch';
  labelStarts();
}
$('tk').addEventListener('input', function () { setTicket($('tk').value); });
$('tk').addEventListener('keydown', function (e) { if (e.key === 'Escape') setTicket(''); });
$('cmd').addEventListener('click', function () { $('tk').focus(); });
labelStarts();
function renderStarts(s) {
  if (s.KEY !== KEY) { KEY = s.KEY; key = s.key; $('key').textContent = key; }
  nextNames = s.starts; labelStarts();
}

var lastKey = '', lastDraw = 0;
function render(s) {
  renderStarts(s); renderModes(s); renderAlerts(s); renderMachine(s); renderGreenhouse(s);
  // Redraw on change, or every 10s for the ages, so a text selection survives between polls.
  var k = JSON.stringify([s.rows, s.db, s.waiting, s.heavy, s.stack, s.stackDown, s.dev, s.flows, s.log[0]]);
  if (k === lastKey && Date.now() - lastDraw < 10000) return;
  lastKey = k; lastDraw = Date.now();
  renderStages(s); renderFlows(s); renderLocks(s); renderTimeline(s); renderLog(s);
  var needing = s.rows.filter(function (r) { return r.chat && r.chat.needs; }).length;
  document.title = (needing ? '(' + needing + ' need you) ' : s.waiting.length ? '(' + s.waiting.length + ' db-wait) ' : '') + 'gh-dash ' + key;
}

function tick() {
  fetch('/api/state', { cache: 'no-store' })
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(function (s) { render(s); $('link').className = 'g'; $('link').textContent = '● CONNECTED'; })
    .catch(function () { $('link').className = 'r'; $('link').textContent = '● DISCONNECTED'; });
}
function clock() { $('clock').textContent = new Date().toLocaleTimeString([], { hour12: false }); }
tick(); clock();
setInterval(tick, 2000);
setInterval(clock, 1000);
</script>
</body>
</html>
`;
